# Base path of the REST API (same-origin by default; set full URL if API is on another host)
VITE_API_BASE=/api

# Socket.IO endpoint (empty = same origin)
VITE_SOCKET_URL=

# Optional TURN server for WebRTC behind strict NATs (format: turn:host:port)
# VITE_TURN_URL=
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
