# Server
NODE_ENV=development
PORT=5000

# Database
MONGO_URI=mongodb://127.0.0.1:27017/securechat

# CORS / client origins (comma separated)
CLIENT_URLS=http://localhost:5173,http://localhost:8080

# JWT - generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-min-32-chars-random-hex-string-1
JWT_REFRESH_SECRET=change-me-min-32-chars-random-hex-string-2
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Password hashing cost
BCRYPT_ROUNDS=12

# Cookies (enable behind HTTPS)
COOKIE_SECURE=false

# Email verification (true blocks login until verified; links are logged to console when SMTP is not configured)
EMAIL_VERIFICATION_REQUIRED=true

# SMTP (leave empty to log emails to console in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Secure Chat <no-reply@localhost>"
APP_PUBLIC_URL=http://localhost:5173

# Bootstrap admin (optional, used by npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!123

# HTTPS (optional direct TLS; prefer reverse proxy in production)
ENABLE_HTTPS=false
TLS_KEY_PATH=./certs/key.pem
TLS_CERT_PATH=./certs/cert.pem

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_MB=25

# Logging
LOG_PRETTY=true
